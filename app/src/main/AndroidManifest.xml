<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- 蓝牙钥匙后台保活：以 connectedDevice 前台服务常驻，开机 / 升级后自动恢复 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 仅 Android 9 及以下保存收款码到相册时需要；Android 10+ 走 MediaStore，无需权限 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- 应用内下载新版本后直接唤起系统安装器（Android 8+ 还需用户在系统里授权一次） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 语音记账：灵感球长按说话走进程内 SpeechRecognizer（要自己画 Siri 式浮层），
         系统语音 App 那条路做不到自绘界面，所以必须自己申请麦克风 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Android 11+ 包可见性：不加这段 isRecognitionAvailable() 会恒返回 false -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:name=".LeapApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.LeapBuddy"
        android:usesCleartextTraffic="true">

        <!--
          主界面自身不再声明 LAUNCHER：桌面图标由下面两个 activity-alias 承载，
          靠 PackageManager.setComponentEnabledSetting 二选一启用，实现「换图标」。

          为什么这么做：adaptive icon 的图是编译期资源，运行时改不了；
          只能预置两套 alias，切换时启用其一、禁用另一个，桌面图标随之变化。
          （用户选的样式存在 SessionStore，切换后提示用户重启 App 生效。）
        -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- 默认：方向盘图标（新标，规避商标风险） -->
        <activity-alias
            android:name=".LauncherSteering"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 备用：零跑官方 logo（默认禁用，需在设置里解锁后在个性化里切换） -->
        <activity-alias
            android:name=".LauncherOfficial"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_official"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_official_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".CrashActivity"
            android:exported="false"
            android:label="崩溃信息"
            android:theme="@style/Theme.LeapBuddy" />

        <!-- 更新包在 filesDir/update/ 里，安装时要通过 content:// 交给系统安装器 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 蓝牙钥匙后台服务：连接车辆、维持无感解锁所需的 BLE 链路 -->
        <service
            android:name=".bluetooth.BleKeyService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- 开机 / 应用升级后自动恢复后台蓝牙钥匙 -->
        <receiver
            android:name=".bluetooth.BleKeyBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 系统控制中心快捷磁贴（ACTIVE_TILE：点击即在应用内执行，不折叠面板） -->
        <service
            android:name=".tiles.LockTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_lock"
            android:label="上锁"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="true" />
        </service>

        <service
            android:name=".tiles.UnlockTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_unlock"
            android:label="解锁"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="true" />
        </service>

        <service
            android:name=".tiles.HornTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_horn"
            android:label="鸣笛寻车"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="true" />
        </service>

        <service
            android:name=".tiles.ClimateTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_ac"
            android:label="空调"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="true" />
        </service>

        <service
            android:name=".tiles.TrunkTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_trunk"
            android:label="后备箱"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="true" />
        </service>

        <service
            android:name=".tiles.WindowTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_window"
            android:label="车窗"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="true" />
        </service>

        <service
            android:name=".tiles.BatteryHeatTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_battery_heat"
            android:label="电池预热"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="true" />
        </service>

        <service
            android:name=".tiles.SunshadeTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_sunshade"
            android:label="遮阳帘"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="true" />
        </service>
    </application>

</manifest>
