<?xml version="1.0" encoding="utf-8"?>
<!-- 小组件底卡（浅色）：近白 + 一条极淡描边。
     纯白放在白色壁纸上会「消失」，所以底色压到 #FCFDFE 再加 0.8dp 描边把轮廓交代出来。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FCFDFE" />
    <corners android:radius="22dp" />
    <stroke
        android:width="0.8dp"
        android:color="#1A1A2030" />
</shape>
