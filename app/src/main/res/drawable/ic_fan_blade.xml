<?xml version="1.0" encoding="utf-8"?>
<!--
  四叶风扇（空调开关用）。
  和 ic_ac_fan（那版叶片太胖，四片连成一整块）不同：这一版叶片收窄、带一点顺时针偏心，
  四片之间留出缝隙，中心再用一个小圆把叶片收在一起 —— 缩小到 20dp 也还是一眼能看出是风扇在转。
  四片是「同一片叶子旋转 90°/180°/270°」预计算好的固定路径（不用 <group> 旋转，渲染零歧义）。
  颜色由运行时 tint 上色。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- 中心轴：把四片扇叶收在一点，避免中间漏出方孔 -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M10.05,12 A1.95,1.95 0 1 1 13.95,12 A1.95,1.95 0 1 1 10.05,12 Z" />

    <path
        android:fillColor="#FF000000"
        android:pathData="M 11.90 10.90 C 12.20 8.50 12.90 6.20 14.40 4.70 C 16.10 2.90 19.20 3.50 19.40 6.10 C 19.60 8.70 16.70 10.50 11.90 10.90 Z" />

    <path
        android:fillColor="#FF000000"
        android:pathData="M 13.10 11.90 C 15.50 12.20 17.80 12.90 19.30 14.40 C 21.10 16.10 20.50 19.20 17.90 19.40 C 15.30 19.60 13.50 16.70 13.10 11.90 Z" />

    <path
        android:fillColor="#FF000000"
        android:pathData="M 12.10 13.10 C 11.80 15.50 11.10 17.80 9.60 19.30 C 7.90 21.10 4.80 20.50 4.60 17.90 C 4.40 15.30 7.30 13.50 12.10 13.10 Z" />

    <path
        android:fillColor="#FF000000"
        android:pathData="M 10.90 12.10 C 8.50 11.80 6.20 11.10 4.70 9.60 C 2.90 7.90 3.50 4.80 6.10 4.60 C 8.70 4.40 10.50 7.30 10.90 12.10 Z" />
