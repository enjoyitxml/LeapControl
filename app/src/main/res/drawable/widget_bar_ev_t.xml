<?xml version="1.0" encoding="utf-8"?>
<!-- 全透明主题 · 纯电续航条（浅色字版）
     半透明白轨道 + 提亮一档的绿。深壁纸上看不清原色绿，这一档是为压在照片/深色壁纸上准备的。
     颜色写死在这里而不是运行时改：ProgressBar 没有 setProgressDrawable(int) 这种签名，
     RemoteViews 的 setInt 反射调用会直接失败，所以亮 / 暗各备一份，由 WidgetStyle.isLight 挑。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="3.5dp" />
            <solid android:color="#33FFFFFF" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="3.5dp" />
                <solid android:color="#3DD68C" />
            </shape>
        </clip>
    </item>
</layer-list>
