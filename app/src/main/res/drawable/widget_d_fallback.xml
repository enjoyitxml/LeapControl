<?xml version="1.0" encoding="utf-8"?>
<!-- 沉浸样式没选自定义图时的默认底：一段黄昏天空的渐变。
     只用一层线性渐变，标准小组件拿不到模糊和噪点，做不出真实照片的质感，
     所以宁可一眼看出这是「一副配色」而不是一张糊掉的照片。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#3F5266"
        android:startColor="#9DB3C9" />
</shape>
