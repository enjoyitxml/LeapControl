<?xml version="1.0" encoding="utf-8"?>
<!--
  桌面小组件 4x2 —— 版式照澎湃原生那一版对齐：
    第一行  车标 + 车名（APP 里的自定义车名）+ 更新时间 / 状态（紧跟车名，右侧不放东西）
    第二行  纯电续航 + 绿条   燃油续航 + 蓝条   车模
    第三行  解锁 │ 上锁 │ 空调 │ 后备箱 │ 鸣笛（快捷控车栏同款图标，无文字标签）

  三个关键约束：
  1. RemoteViews 只认 LinearLayout / TextView / ImageView / ProgressBar，没有约束布局；
  2. 尺寸不能写死。卡片被拉到 320×150 或压到 250×110，内容都得跟着变 ——
     所以「数据行」和「按键行」都用 weight 分高度、图标用 match_parent + fitCenter 自动缩放，
     文字字号在 VehicleWidget.buildViews 里按卡片的实际 dp 尺寸二次设置；
  3. 纯电车型没有燃油续航，`wg_fuel_block` 整块 GONE（GONE 的子视图不参与 weight 分配，
     纯电时长续航块会自动变宽，不会留下一条空洞）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wg_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card">

    <!-- 背景照片：垫在最底层，所有内容压在上面。
         圆角是运行时按卡片的真实像素画进 bitmap 的（RemoteViews 不能 clipToOutline），
         所以这里 fitXY 铺满就行；没选背景时整块 GONE，露出下面的玻璃卡。 -->
    <ImageView
        android:id="@+id/wg_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="7dp">

    <!-- ======== 第一行：车标 + 车名 + 更新时间（紧挨车名，右侧留空给车模） ========
         时间原先独立占右侧一列，把它收到车名后面之后，右边的横向空间整块让给车模。
         车名用 wrap_content 才能紧贴时间，所以用 maxWidth 兜住超长自定义车名（超出省略号）。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 车标：宽高比跟 ic_wg_logo 的视口一致（0.86），fitCenter 才不会压扁 -->
        <ImageView
            android:id="@+id/wg_logo"
            android:layout_width="15dp"
            android:layout_height="17.5dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_wg_logo" />

        <TextView
            android:id="@+id/wg_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:maxWidth="116dp"
            android:text="我的零跑"
            android:textColor="#12141A"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wg_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="尚未同步"
            android:textColor="#8A9099"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- ======== 第二行：续航两个大数字 + 车模（点它打开 App） ======== -->
    <LinearLayout
        android:id="@+id/wg_top"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 左：纯电续航 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/wg_ev_range"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="--"
                    android:textColor="#12141A"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/wg_ev_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:layout_marginBottom="3dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="km"
                    android:textColor="#6C7480"
                    android:textSize="10sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/wg_bar_ev"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="12dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/widget_bar" />
        </LinearLayout>

        <!-- 右：燃油续航（只有增程车型才显示） -->
        <LinearLayout
            android:id="@+id/wg_fuel_block"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/wg_fuel_range"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="--"
                    android:textColor="#12141A"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/wg_fuel_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:layout_marginBottom="3dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="km"
                    android:textColor="#6C7480"
                    android:textSize="10sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/wg_bar_fuel"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="12dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/widget_bar_range" />
        </LinearLayout>

        <!-- 车模：透明底 PNG，fitCenter 不变形。
             权重 1.9 → 2.45：更新时间从右上角挪走之后，把腾出来的横向空间给车模，
             两张续航块只保持够放「3 位数 + km」的宽度（250dp 卡下仍放得下）。 -->
        <ImageView
            android:id="@+id/wg_car"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="2.45"
            android:contentDescription="车辆"
            android:scaleType="fitCenter"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ======== 第三行：解锁 / 上锁 / 空调 / 后备箱 ======== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:layout_weight="1.05"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/wg_cell_unlock"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_cell"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/wg_icon_unlock"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="解锁"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_qc_unlock" />
        </LinearLayout>

        <TextView
            android:id="@+id/wg_div_1"
            android:layout_width="1px"
            android:layout_height="20dp"
            android:layout_gravity="center_vertical"
            android:background="#1412141A" />

        <LinearLayout
            android:id="@+id/wg_cell_lock"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_cell"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/wg_icon_lock"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="上锁"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_qc_lock" />
        </LinearLayout>

        <TextView
            android:id="@+id/wg_div_2"
            android:layout_width="1px"
            android:layout_height="20dp"
            android:layout_gravity="center_vertical"
            android:background="#1412141A" />

        <LinearLayout
            android:id="@+id/wg_cell_ac"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_cell"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/wg_icon_ac"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="空调"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_wg_fan" />
        </LinearLayout>

        <TextView
            android:id="@+id/wg_div_3"
            android:layout_width="1px"
            android:layout_height="20dp"
            android:layout_gravity="center_vertical"
            android:background="#1412141A" />

        <LinearLayout
            android:id="@+id/wg_cell_trunk"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_cell"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/wg_icon_trunk"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="后备箱"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_qc_trunk" />
        </LinearLayout>

        <TextView
            android:id="@+id/wg_div_4"
            android:layout_width="1px"
            android:layout_height="20dp"
            android:layout_gravity="center_vertical"
            android:background="#1412141A" />

        <!-- 鸣笛寻车：单次指令，点一次发一次 -->
        <LinearLayout
            android:id="@+id/wg_cell_horn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_cell"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/wg_icon_horn"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="鸣笛寻车"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_qc_horn" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
</FrameLayout>
