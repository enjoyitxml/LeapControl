<?xml version="1.0" encoding="utf-8"?>
<!--
  桌面小组件 4x2 —— 版式照澎湃原生那一版对齐：
    第一行  车标 + 车名（左）          更新时间 / 状态（右）
    第二行  电量大数字 + 绿条   续航大数字 + 蓝条   车模
    第三行  解锁 │ 上锁 │ 空调 │ 后备箱（四个纯图标，无文字标签）

  两个关键约束：
  1. RemoteViews 只认 LinearLayout / TextView / ImageView / ProgressBar，没有约束布局；
  2. 尺寸不能写死。卡片被拉到 320×150 或压到 250×110，内容都得跟着变 ——
     所以「数据行」和「按键行」都用 weight 分高度、图标用 match_parent + fitCenter 自动缩放，
     文字字号在 VehicleWidget.buildViews 里按卡片的实际 dp 尺寸二次设置。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card"
    android:orientation="vertical"
    android:paddingStart="15dp"
    android:paddingTop="12dp"
    android:paddingEnd="15dp"
    android:paddingBottom="4dp">

    <!-- ======== 第一行：车标 + 车名 + 更新时间 ======== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_wg_logo" />

        <TextView
            android:id="@+id/wg_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="我的零跑"
            android:textColor="#12141A"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wg_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="尚未同步"
            android:textColor="#8A9099"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- ======== 第二行：两个大数字 + 车模（点它打开 App） ======== -->
    <LinearLayout
        android:id="@+id/wg_top"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 左：电量 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/wg_soc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="--"
                    android:textColor="#12141A"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/wg_soc_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:layout_marginBottom="3dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="%"
                    android:textColor="#6C7480"
                    android:textSize="11sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/wg_bar_soc"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3.5dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="10dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/widget_bar" />
        </LinearLayout>

        <!-- 右：续航 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/wg_range"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="--"
                    android:textColor="#12141A"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/wg_range_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:layout_marginBottom="3dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="km"
                    android:textColor="#6C7480"
                    android:textSize="11sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/wg_bar_range"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3.5dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="10dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/widget_bar_range" />
        </LinearLayout>

        <!-- 车模：透明底 PNG，fitCenter 不变形 -->
        <ImageView
            android:id="@+id/wg_car"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:layout_weight="1.9"
            android:contentDescription="车辆"
            android:scaleType="fitCenter"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ======== 第三行：解锁 / 上锁 / 空调 / 后备箱 ======== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.9"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/wg_cell_unlock"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_cell"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/wg_icon_unlock"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="解锁"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_wg_unlock" />
        </LinearLayout>

        <TextView
            android:layout_width="1px"
            android:layout_height="18dp"
            android:layout_gravity="center_vertical"
            android:background="#1F12141A" />

        <LinearLayout
            android:id="@+id/wg_cell_lock"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_cell"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/wg_icon_lock"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="上锁"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_wg_lock" />
        </LinearLayout>

        <TextView
            android:layout_width="1px"
            android:layout_height="18dp"
            android:layout_gravity="center_vertical"
            android:background="#1F12141A" />

        <LinearLayout
            android:id="@+id/wg_cell_ac"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_cell"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/wg_icon_ac"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="空调"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_wg_ac" />
        </LinearLayout>

        <TextView
            android:layout_width="1px"
            android:layout_height="18dp"
            android:layout_gravity="center_vertical"
            android:background="#1F12141A" />

        <LinearLayout
            android:id="@+id/wg_cell_trunk"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_cell"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/wg_icon_trunk"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="后备箱"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_wg_trunk" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
